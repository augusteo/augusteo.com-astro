---
// Reading progress indicator — thin ochre bar fixed at the top of the viewport,
// fills as the reader moves through the <article>. Only mounted via PostLayout.
---

<div id="reading-progress" class="reading-progress" aria-hidden="true">
  <div class="reading-progress__fill"></div>
</div>

<script>
  let cleanup: (() => void) | null = null;

  function initReadingProgress() {
    cleanup?.();
    cleanup = null;

    const bar = document.getElementById("reading-progress");
    const article = document.querySelector("article");
    if (!bar || !article) return;

    let rafId: number | null = null;

    const update = () => {
      rafId = null;
      const rect = article.getBoundingClientRect();
      const articleTop = rect.top + window.scrollY;
      const articleHeight = article.offsetHeight;
      const viewport = window.innerHeight;
      const scrollable = articleHeight - viewport;

      const progress =
        scrollable <= 0
          ? 1
          : Math.max(
              0,
              Math.min(1, (window.scrollY - articleTop) / scrollable)
            );

      bar.style.setProperty("--reading-progress", String(progress));
      bar.classList.toggle("is-visible", window.scrollY > 120);
    };

    const schedule = () => {
      if (rafId === null) rafId = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    const ro = new ResizeObserver(schedule);
    ro.observe(article);
    update();

    cleanup = () => {
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
      ro.disconnect();
      if (rafId !== null) cancelAnimationFrame(rafId);
    };
  }

  initReadingProgress();
  document.addEventListener("astro:after-swap", initReadingProgress);
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 200;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
    --reading-progress: 0;
  }

  .reading-progress.is-visible {
    opacity: 1;
  }

  .reading-progress__fill {
    height: 100%;
    width: 100%;
    transform-origin: left center;
    transform: scaleX(var(--reading-progress));
    background: var(--color-accent-ochre);
    mask-image: linear-gradient(
      to right,
      black calc(100% - 6px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      black calc(100% - 6px),
      transparent 100%
    );
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      transition: none;
    }
  }

  @media print {
    .reading-progress {
      display: none;
    }
  }
</style>
